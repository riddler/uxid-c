---
# The checks the gate runs with clang-tidy over the library and the tests,
# through the compile database the default preset writes. Every warning is
# an error.
Checks: >-
  -*,
  bugprone-*,
  cert-*,
  clang-analyzer-*,
  misc-*,
  performance-*,
  portability-*,
  readability-*,
  -bugprone-easily-swappable-parameters,
  -clang-analyzer-security.insecureAPI.DeprecatedOrUnsafeBufferHandling,
  -readability-identifier-length,
  -readability-magic-numbers
WarningsAsErrors: '*'
HeaderFilterRegex: '.*/include/uxid\.h$'
...
