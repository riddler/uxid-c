{
  "wurk": 1,

  "beads": {
    "prefix": "uxc",
    "sync": "dolthub",
    "topology": "beads",
    "areas": {
      "labels": [
        "area:codec",
        "area:monotonic",
        "area:conformance",
        "area:docs",
        "area:build"
      ],
      "lands_alone": ["area:build"],
      "always_batchable": ["upstream"]
    }
  },

  "forge": {
    "kind": "github",
    "labels": {}
  },

  "gate": {
    "full": ["mise", "run", "gate"],
    "loop": ["mise", "run", "gate:loop"],
    "build_paths": [
      "src/",
      "include/",
      "tests/",
      "cmake/",
      "scripts/",
      "CMakeLists.txt",
      "CMakePresets.json",
      "mise.toml",
      ".clang-format",
      ".clang-tidy",
      ".editorconfig"
    ],
    "also_gated_paths": ["conformance/", "README.md"],
    "moving_files": [
      "mise.toml",
      "CMakeLists.txt",
      "CMakePresets.json",
      ".clang-format",
      ".clang-tidy"
    ],
    "sabotage": {
      "test_roots": ["tests/"],
      "test_pattern": "^\\s*static void test_[A-Za-z0-9_]+\\(void\\)",
      "exempt_prefixes": [],
      "note_forms": ["comment", "in_name"]
    },
    "project_level_skips": [],
    "not_applicable_skips": []
  },

  "parallelism": {
    "model": "worktree-per-issue",
    "worktrees_dir": "../uxid-c-worktrees",
    "trust": ["mise", "trust", "{path}"],
    "warm_clone": [],
    "warm": [["mise", "exec", "--", "cmake", "--preset", "default"]],
    "repair_when": "CMakeLists.txt",
    "repair": [["mise", "exec", "--", "cmake", "--preset", "default"]],
    "post_branch": []
  },

  "tmux": {
    "session": "uxid-c",
    "model": "opus"
  },

  "models": {
    "direction": "fable"
  },

  "artifacts": {
    "plans": "docs/plans",
    "research": "docs/research",
    "filename": "YYMMDD-[id-]kebab"
  },

  "commits": {
    "style": "s-form",
    "subject_under": 72,
    "body_line_max": 72,
    "total_lines_max": 40,
    "trailer": {
      "key": "Refs"
    }
  },

  "changelog": {
    "mode": "fragments",
    "dir": "changelog.d"
  },

  "release": {
    "kind": "github-release",
    "version_file": "include/uxid.h",
    "readme_pin": true
  }
}
